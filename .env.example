# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Keys should come from your approved secrets store; do not paste them into
# tickets, chat, or shell history.

# Staging only — never point this at production.
BASE_URL=https://api.invoiced-backend-staging.invoiced.com

# Multiple API keys: ONE comma-separated line, no spaces, no quotes needed.
# Each key gets its own 20-concurrent-request allowance; VUs are spread across keys.
API_KEYS=API_KEYS=<api_key_1>,<api_key_2>,<api_key_3>

# Basic auth password (normally empty for the Invoiced API)
BASIC_PASS=

# Optional load settings
VUS=60
TOTAL_ITERATIONS=100000
PROFILE=steps
STAGES=5:2m,20:5m,50:5m,0:10m
